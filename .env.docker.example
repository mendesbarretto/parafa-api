APP_NAME="Parafa CNPJ API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://cnpj-api
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Banco CNPJ. O host Docker aponta para o PostgreSQL instalado na máquina.
DB_CONNECTION2=pgsql
DB_HOST2=host.docker.internal
DB_PORT2=5432
DB_DATABASE2=cnpj
DB_USERNAME2=
DB_PASSWORD2=
DB_SSLMODE2=prefer

# A API usa cache local do container; não precisa do banco principal Laravel.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

CNPJ_SITE_URL=https://cnpj.parafa.com.br

# Configure um transporte real antes de habilitar solicitações em produção.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contato@parafa.com.br
MAIL_FROM_NAME="Parafa CNPJ"
